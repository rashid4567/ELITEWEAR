                date: "July 10, 2023"
            }
        ];

        const categories = [
            { name: "Style Guides", count: 12 },
            { name: "Fashion Trends", count: 8 },
            { name: "Craftsmanship", count: 6 },
            { name: "Care & Maintenance", count: 5 },
            { name: "Sustainability", count: 4 },
            { name: "Behind the Scenes", count: 3 }
        ];

        const tags = [
            "Business Attire", "Casual Style", "Formal Wear", "Summer Fashion", 
            "Winter Essentials", "Fabric Guide", "Color Theory", "Styling Tips", 
            "Custom Tailoring", "Sustainable Fashion", "Shirt Care", "Accessories"
        ];

        const breakingNews = [
            "New Fall Collection launching next week - exclusive preview for subscribers",
            "Elite Wear opens new flagship store in Milan",
            "Limited edition collaboration with renowned designer James Smith",
            "Sustainable cotton initiative reduces our carbon footprint by 30%",
            "CEO interview: The future of premium menswear in the digital age"
        ];

        // Function to render featured posts
        function renderFeaturedPosts() {
            const container = document.getElementById('featuredPostsContainer');
            container.innerHTML = '';

            // Get the first two posts for the featured section
            const featuredPosts = blogPosts.slice(0, 2);
            
            featuredPosts.forEach(post => {
                const postHTML = `
                    <div class="col-md-6">
                        <div class="card blog-card">
                            <div class="position-relative">
                                <img src="${post.image}" class="card-img-top blog-card-img" alt="${post.title}">
                                ${post.isNew ? '<span class="new-post-indicator">NEW</span>' : ''}
                            </div>
                            <div class="card-body">
                                <span class="blog-card-tag">${post.tag}</span>
                                <h3 class="blog-card-title"><a href="/blog/post/${post.id}">${post.title}</a></h3>
                                <p class="blog-card-excerpt">${post.excerpt}</p>
                                <div class="blog-card-meta">
                                    <img src="${post.authorImage}" alt="${post.author}">
                                    <div>${post.author}</div>
                                    <span class="blog-card-meta-divider">|</span>
                                    <div>${post.date}</div>
                                    <span class="blog-card-meta-divider">|</span>
                                    <div><i class="bi bi-clock me-1"></i> ${post.readTime}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += postHTML;
            });
        }

        // Function to render more posts
        function renderMorePosts() {
            const container = document.getElementById('morePostsContainer');
            container.innerHTML = '';

            // Get the remaining posts
            const morePosts = blogPosts.slice(2);
            
            morePosts.forEach(post => {
                const postHTML = `
                    <div class="col-md-6">
                        <div class="card blog-card">
                            <div class="position-relative">
                                <img src="${post.image}" class="card-img-top blog-card-img" alt="${post.title}">
                                ${post.isNew ? '<span class="new-post-indicator">NEW</span>' : ''}
                            </div>
                            <div class="card-body">
                                <span class="blog-card-tag">${post.tag}</span>
                                <h3 class="blog-card-title"><a href="/blog/post/${post.id}">${post.title}</a></h3>
                                <p class="blog-card-excerpt">${post.excerpt}</p>
                                <div class="blog-card-meta">
                                    <img src="${post.authorImage}" alt="${post.author}">
                                    <div>${post.author}</div>
                                    <span class="blog-card-meta-divider">|</span>
                                    <div>${post.date}</div>
                                    <span class="blog-card-meta-divider">|</span>
                                    <div><i class="bi bi-clock me-1"></i> ${post.readTime}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += postHTML;
            });
        }

        // Function to render popular posts
        function renderPopularPosts() {
            const container = document.getElementById('popularPostsContainer');
            container.innerHTML = '';
            
            popularPosts.forEach(post => {
                const postHTML = `
                    <div class="sidebar-post">
                        <img src="${post.image}" alt="${post.title}" class="sidebar-post-img">
                        <div>
                            <h5 class="sidebar-post-title"><a href="/blog/post">${post.title}</a></h5>
                            <div class="sidebar-post-date">${post.date}</div>
                        </div>
                    </div>
                `;
                container.innerHTML += postHTML;
            });
        }

        // Function to render categories
        function renderCategories() {
            const container = document.getElementById('categoriesContainer');
            container.innerHTML = '';
            
            categories.forEach(category => {
                const categoryHTML = `
                    <li><a href="/blog/category/${category.name.toLowerCase().replace(/\s+/g, '-')}">${category.name} <span class="sidebar-categories-count">${category.count}</span></a></li>
                `;
                container.innerHTML += categoryHTML;
            });
        }

        // Function to render tags
        function renderTags() {
            const container = document.getElementById('tagsContainer');
            container.innerHTML = '';
            
            tags.forEach(tag => {
                const tagHTML = `
                    <a href="/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}" class="sidebar-tag">${tag}</a>
                `;
                container.innerHTML += tagHTML;
            });
        }

        // Function to render breaking news ticker
        function renderBreakingNews() {
            const container = document.getElementById('breakingNewsTicker');
            container.innerHTML = '';
            
            // Duplicate the array to create a continuous loop effect
            const duplicatedNews = [...breakingNews, ...breakingNews];
            
            duplicatedNews.forEach(news => {
                const newsHTML = `
                    <div class="breaking-news-item">${news}</div>
                `;
                container.innerHTML += newsHTML;
            });
        }

        // Function to simulate new posts being added
        function simulateNewPosts() {
            // Create new post data
            const newPosts = [
                {
                    id: 7,
                    image: "https://images.unsplash.com/photo-1594938298603-c8148c4dae35?q=80&w=1980&auto=format&fit=crop",
                    tag: "Craftsmanship",
                    title: "The Details That Matter: Crafting the Perfect Shirt",
                    excerpt: "Discover the subtle details that elevate a good shirt to a great one. From stitching techniques to button selection, learn what to look for in premium menswear.",
                    author: "Richard Harlow",
                    authorImage: "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?q=80&w=1964&auto=format&fit=crop",
                    date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
                    readTime: "7 min read",
                    isNew: true
                },
                {
                    id: 8,
                    image: "https://images.unsplash.com/photo-1588359348347-9bc6cbbb689e?q=80&w=1974&auto=format&fit=crop",
                    tag: "Style Guide",
                    title: "Color Psychology: Choosing Shirts That Enhance Your Professional Image",
                    excerpt: "The colors you wear communicate subtle messages in professional settings. Learn how to strategically select shirt colors to project confidence, trustworthiness, and authority.",
                    author: "Sophia Martinez",
                    authorImage: "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?q=80&w=1974&auto=format&fit=crop",
                    date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
                    readTime: "5 min read",
                    isNew: true
                }
            ];

            // Add new posts to the beginning of the array
            blogPosts.unshift(...newPosts);

            // Update hero section with the newest post
            updateHeroSection(blogPosts[0]);

            // Show notification
            const liveUpdatesBadge = document.getElementById('liveUpdatesBadge');
            liveUpdatesBadge.classList.add('show');

            // Add new breaking news
            breakingNews.unshift("JUST IN: New article on shirt color psychology published - read now");
            renderBreakingNews();
        }

        // Function to update hero section
        function updateHeroSection(post) {
            document.getElementById('heroImage').src = post.image;
            document.getElementById('heroTag').textContent = post.tag;
            document.getElementById('heroTitle').textContent = post.title;
            document.getElementById('heroExcerpt').textContent = post.excerpt;
            document.getElementById('heroAuthorImage').src = post.authorImage;
            document.getElementById('heroAuthor').textContent = `By ${post.author}`;
            document.getElementById('heroDate').textContent = post.date;
            document.getElementById('heroReadTime').textContent = post.readTime;
        }

        // Function to refresh content when notification is clicked
        document.getElementById('liveUpdatesBadge').addEventListener('click', function() {
            // Re-render all content with the updated data
            renderFeaturedPosts();
            renderMorePosts();
            
            // Hide notification
            this.classList.remove('show');
            
            // Scroll to top to show new content
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Initial render
        document.addEventListener('DOMContentLoaded', function() {
            renderFeaturedPosts();
            renderMorePosts();
            renderPopularPosts();
            renderCategories();
            renderTags();
            renderBreakingNews();
            
            // Set hero section to first post
            updateHeroSection(blogPosts[0]);
            
            // Simulate new posts after a delay (in a real app, this would be a server-side event)
            setTimeout(simulateNewPosts, 30000); // 30 seconds
            
            // Set up periodic content refresh (in a real app, this would use WebSockets or Server-Sent Events)
            setInterval(function() {
                // Check for new content from the server
                // This is a simulation - in a real app, you would make an API call
                fetch('/api/blog/check-updates?lastUpdate=' + new Date().toISOString())
                    .then(response => response.json())
                    .catch(error => {
                        console.log('Simulating server response...');
                        // Simulate server response
                        return { hasUpdates: Math.random() > 0.7 }; 
                    })
                    .then(data => {
                        if (data && data.hasUpdates) {
                            simulateNewPosts();
                        }
                    });
            }, 60000); 
        });
    </script>
</body>
</html>